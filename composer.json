{
    "name": "gaillardy/api-mailer",
    "description": "API PHP sécurisée et modulaire pour l'envoi d'emails de contact avec PHPMailer",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.1",
        "phpmailer/phpmailer": "^7.0",
        "vlucas/phpdotenv": "^5.6"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    }
}
