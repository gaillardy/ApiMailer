# ==============================================================================
# Configuration Générale de l'Application
# ==============================================================================
APP_ENV=production
APP_DEBUG=false

# Clé API secrète utilisée pour authentifier les requêtes (X-API-KEY ou Authorization: Bearer)
# Changez cette valeur par une chaîne aléatoire et complexe (ex: générée avec bin2hex(random_bytes(32)))
API_KEY=votre_cle_api_secrete_tres_longue_ici

# ==============================================================================
# Sécurité CORS (Origines autorisées séparées par des virgules)
# Ne pas ajouter de slash de fin (ex: http://localhost:3000,https://mon-domaine.com)
# ==============================================================================
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,https://exemple.com,https://www.exemple.com

# ==============================================================================
# Configuration SMTP (PHPMailer)
# ==============================================================================
SMTP_HOST=mail.exemple.com
SMTP_PORT=465
SMTP_AUTH=true
SMTP_USERNAME=contact@exemple.com
SMTP_PASSWORD=votre_mot_de_passe_smtp
# Options: ssl (port 465) ou tls (port 587)
SMTP_ENCRYPTION=ssl
SMTP_DEBUG=0

# ==============================================================================
# Expéditeur et Destinataire de l'email
# ==============================================================================
MAIL_FROM_ADDRESS=contact@exemple.com
MAIL_FROM_NAME="Formulaire de Contact"
MAIL_TO_ADDRESS=contact@exemple.com
MAIL_TO_NAME="Support / Destinataire"
MAIL_SUBJECT_PREFIX="[Contact Web]"

# ==============================================================================
# Anti-Spam (Champ Honeypot)
# Si ce champ est rempli par un robot, la requête est silencieusement acceptée sans envoi réel
# ==============================================================================
HONEYPOT_FIELD=_gotcha
